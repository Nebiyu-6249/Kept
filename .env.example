# Neon POOLED connection string. Used by the app at runtime.
DATABASE_URL=

# Neon DIRECT connection string. Used by `prisma migrate` only.
DIRECT_URL=

# Server-side only. Never expose this to the browser.
ANTHROPIC_API_KEY=

APP_TIMEZONE=Asia/Dubai
DEFAULT_CURRENCY=AED
VERDICT_DAILY_LIMIT=100

# Absolute origin the background import function calls back into.
# On Netlify this is provided automatically as URL / DEPLOY_PRIME_URL; set it
# locally if you want to exercise the background import path.
# APP_ORIGIN=http://localhost:3000

# NEVER prefix any of the above with NEXT_PUBLIC_.
# In Netlify: scope DATABASE_URL to Functions + Builds, ANTHROPIC_API_KEY to Functions only.
